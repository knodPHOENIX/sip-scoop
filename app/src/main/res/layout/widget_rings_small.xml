<?xml version="1.0" encoding="utf-8"?>
<!-- Small rings (2x2): the rings fill the widget, numbers below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView android:id="@+id/rings" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/widget_rings_preview" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView
        android:id="@+id/steps_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="6,240"
        android:textColor="@color/widget_gold"
        android:textSize="12sp" android:textStyle="bold" android:layout_weight="1" android:gravity="start"/>
            <TextView
        android:id="@+id/water_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="1.75 L"
        android:textColor="@color/widget_blue"
        android:textSize="12sp" android:textStyle="bold" android:layout_weight="1" android:gravity="center"/>
            <TextView
        android:id="@+id/protein_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="84 g"
        android:textColor="@color/widget_orange"
        android:textSize="12sp" android:textStyle="bold" android:layout_weight="1" android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
