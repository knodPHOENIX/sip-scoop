<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#D9681F" /></shape>
            </item>
            <item android:top="3dp" android:bottom="1dp">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#FF8A3D" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#D9681F" /></shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#FF8A3D" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
